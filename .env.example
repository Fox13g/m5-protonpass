# ============================================================================
# Cardputer Pass Sentinel — Configuração do Bridge Gateway & Cloudflare Tunnel
# ============================================================================

# --- Servidor Bridge (Interno ao Container) ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8443
NODE_ENV=production
LOG_LEVEL=info

# --- Segurança Zero-Trust e Criptografia E2EE (Gerados via `npm run provision`) ---
# Chave de Cifragem de Dados de 256 bits em Hex (64 caracteres hexadecimais)
# Partilhada apenas entre o Bridge Gateway e o Cardputer. A Cloudflare nunca vê esta chave.
SENTINEL_DEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Segredo HMAC-SHA256 de 256 bits em Hex (64 caracteres hexadecimais) para autenticar requisições
SENTINEL_HMAC_SECRET_HEX=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Identificador único do dispositivo Cardputer autorizado
SENTINEL_DEVICE_ID=cardputer-primary-01

# Janela máxima de tolerância de relógio (segundos) contra ataques de Replay
SENTINEL_MAX_CLOCK_SKEW_SEC=60

# --- Integração Proton Pass (`pass-cli`) ---
PASS_CLI_BIN=pass-cli
# Token de Acesso Pessoal (PAT) opcional caso não utilize login interativo no volume
PROTON_PASS_PAT=
# Lista separada por vírgulas de nomes ou IDs de Cofres (Vaults) a sincronizar (vazio = todos)
ALLOWED_VAULTS=Personal,Work
# Se true, impede que edições offline feitas no Cardputer alterem o Proton Pass na nuvem
READ_ONLY_MODE=false

# --- Cloudflare Tunnel (`cloudflared`) ---
# Token do túnel gerado no painel Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# URL pública do seu túnel (usada apenas pelo gerador de provisionamento para o cartão SD)
PUBLIC_TUNNEL_URL=https://sentinel.seudominio.com.br

# Opcional: Cabeçalhos Cloudflare Access Service Auth (enviados pelo Cardputer para passar pelo firewall da borda)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Provisionamento Inicial do Wi-Fi (para gerar cardputer_provision.json) ---
DEFAULT_WIFI_SSID=SuaRedeWiFi2G
DEFAULT_WIFI_PASSWORD=SuaSenhaWiFi

# --- Descoberta Local Opcional (mDNS / USB Serial) ---
ENABLE_MDNS=false
MDNS_SERVICE_NAME=proton-bridge
USB_SERIAL_PORT=

